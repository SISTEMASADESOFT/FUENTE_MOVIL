<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_card_surface">

    <CheckBox
        android:id="@+id/chkGuia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emitir guía de remisión (opcional)"
        android:textColor="@color/fam_ink"
        android:textStyle="bold"
        android:textSize="14sp"
        android:buttonTint="@color/fam_gold" />

    <!-- Se muestra solo cuando el check está marcado -->
    <LinearLayout
        android:id="@+id/layoutGuiaCampos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Serie + número -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Serie"
                app:boxStrokeColor="@color/fam_gold"
                app:hintTextColor="@color/fam_gold"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <AutoCompleteTextView
                    android:id="@+id/ddlSerieGuia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/fam_ink" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="Número"
                app:boxStrokeColor="@color/fam_gold"
                app:hintTextColor="@color/fam_gold"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtNumeroGuia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="none"
                    android:textColor="@color/fam_ink" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Fecha de traslado -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Fecha de traslado"
            app:boxStrokeColor="@color/fam_gold"
            app:hintTextColor="@color/fam_gold"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtFechaTraslado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:textColor="@color/fam_ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Destino (por ahora, la dirección de la factura) -->
        <include
            android:id="@+id/rowDestinoGuia"
            layout="@layout/item_dato_cliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- Tipo de transportista -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Tipo de transportista"
            app:boxStrokeColor="@color/fam_gold"
            app:hintTextColor="@color/fam_gold"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/ddlTipoTransportista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/fam_ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Transportista (tipo 1) -->
        <LinearLayout
            android:id="@+id/layoutTransportista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Transportista (RUC o razón social)"
                app:boxStrokeColor="@color/fam_gold"
                app:hintTextColor="@color/fam_gold"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtBuscarTransportista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/fam_ink" />
            </com.google.android.material.textfield.TextInputLayout>

            <include
                android:id="@+id/rowRucTransportista"
                layout="@layout/item_dato_cliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Conductor (tipo 2) -->
        <LinearLayout
            android:id="@+id/layoutConductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Conductor (DNI o nombre)"
                app:boxStrokeColor="@color/fam_gold"
                app:hintTextColor="@color/fam_gold"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtBuscarConductor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/fam_ink" />
            </com.google.android.material.textfield.TextInputLayout>

            <include
                android:id="@+id/rowDniConductor"
                layout="@layout/item_dato_cliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Bultos + peso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nro. de bultos"
                app:boxStrokeColor="@color/fam_gold"
                app:hintTextColor="@color/fam_gold"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtBultos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5"
                    android:textColor="@color/fam_ink" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="Peso"
                app:boxStrokeColor="@color/fam_gold"
                app:hintTextColor="@color/fam_gold"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtPeso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLength="9"
                    android:textColor="@color/fam_ink" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Unidad de peso -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Unidad de peso"
            app:boxStrokeColor="@color/fam_gold"
            app:hintTextColor="@color/fam_gold"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <AutoCompleteTextView
                android:id="@+id/ddlUnidadPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/fam_ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Placa + marca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Placa"
                app:boxStrokeColor="@color/fam_gold"
                app:hintTextColor="@color/fam_gold"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtPlaca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLength="7"
                    android:textColor="@color/fam_ink" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="Marca"
                app:boxStrokeColor="@color/fam_gold"
                app:hintTextColor="@color/fam_gold"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtMarca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="50"
                    android:textColor="@color/fam_ink" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Licencia -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Licencia"
            app:boxStrokeColor="@color/fam_gold"
            app:hintTextColor="@color/fam_gold"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtLicencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="10"
                android:textColor="@color/fam_ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Observación -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Observación"
            app:boxStrokeColor="@color/fam_gold"
            app:hintTextColor="@color/fam_gold"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtObservacionGuia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLength="250"
                android:textColor="@color/fam_ink" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</LinearLayout>