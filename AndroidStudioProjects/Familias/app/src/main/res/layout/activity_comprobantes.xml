<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fam_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fam_bg"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:navigationIconTint="@color/fam_ink"
        app:title="Consulta Cotizaciones"
        app:titleTextColor="@color/fam_ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Filtro de fecha por rango -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <CheckBox
                android:id="@+id/chkFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="FECHA"
                android:textColor="@color/fam_ink"
                android:textStyle="bold"
                android:textSize="12sp"
                android:buttonTint="@color/fam_gold" />

            <TextView
                android:id="@+id/txtDesde"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_pill"
                android:gravity="center"
                android:textColor="@color/fam_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtHasta"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_pill"
                android:gravity="center"
                android:textColor="@color/fam_ink"
                android:textSize="13sp" />
        </LinearLayout>
        <!-- Buscador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/fam_gold" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtBuscarComprobante"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="Buscar por número, cliente o RUC..."
                android:textColorHint="@color/fam_ink_faint"
                android:textColor="@color/fam_ink"
                android:textSize="13sp"
                android:inputType="text"
                android:singleLine="true" />
        </LinearLayout>




        <TextView
            android:id="@+id/txtContadorComp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/fam_ink_soft"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressComprobantes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:indeterminateTint="@color/fam_gold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtSinComprobantes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:textColor="@color/fam_ink_soft"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeComprobantes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComprobantes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>